# OPENAI_API_KEY is entered in the UI (or sent via the X-OpenAI-Api-Key
# header) rather than kept here. Uncomment only for local/dev fallback:
# OPENAI_API_KEY=sk-...

# Only needed to run scripts/compare_classifiers.py (OpenAI vs Gemini
# accuracy comparison) - the app's normal classify path never reads this.
# GEMINI_API_KEY=...
# GEMINI_CLASSIFY_MODEL=gemini-2.5-flash

# Optional: routes every OpenAI call through a Cloudflare AI Gateway
# (caching/logging/retries at the edge) instead of hitting OpenAI directly.
# Same OPENAI_API_KEY still required - this doesn't replace it. Create a
# gateway at dash.cloudflare.com -> AI -> AI Gateway to get these two values.
# CLOUDFLARE_ACCOUNT_ID=...
# CLOUDFLARE_AI_GATEWAY_ID=ticket-classifier

# Optional: automatic classify() fallback to Cloudflare Workers AI when
# OpenAI hits its rate limit - a separate quota from OpenAI's, so
# classification keeps working instead of stalling. Needs a Cloudflare API
# token with "Workers AI" permission (My Profile -> API Tokens -> Create
# Token -> Custom -> Account: Workers AI: Edit). CLOUDFLARE_ACCOUNT_ID above
# is reused; only the token is new here.
# CLOUDFLARE_API_TOKEN=...
# CLOUDFLARE_WORKERS_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# Single admin login that gates the whole app - CHANGE THESE before deploying
# anywhere beyond your own machine. Defaults to admin/admin if unset.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Zoho Creator integration - SAMPLE values, swap when the real invoke URL and
# credentials are ready. URL must contain a literal {ticket_id} placeholder.
# Header name/value and field names are best guesses - see
# zoho-invoke-url-setup.md section 4 for how to correct these against reality.
ZOHO_INVOKE_URL=https://REPLACE_WITH_REAL_ZOHO_CUSTOM_API/get-ticket?ticket_id={ticket_id}
ZOHO_AUTH_HEADER_NAME=Ticket_Classification_version_0
ZOHO_API_KEY=sample-zoho-key
ZOHO_FIELD_TICKET_ID=Ticket_ID
ZOHO_FIELD_ISSUE_DETAIL=Issue_in_Detail

# Shared secret for the PUSH direction: Zoho Creator's "On Add" workflow
# sends this back as the X-Webhook-Secret header when POSTing a new ticket
# to /api/webhooks/zoho/tickets. Empty by default = that endpoint refuses
# every request. Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
ZOHO_WEBHOOK_SECRET=

# Required for /api/webhooks/zoho/tickets specifically (no UI operator is
# present to supply a key per-request the way the manual/UI flow does).
# Uncomment and set for that endpoint to work:
# OPENAI_API_KEY=sk-...

# Optional overrides
OPENAI_CLASSIFY_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Confidence below this triggers a clarifying question instead of a final label
CONFIDENCE_THRESHOLD=0.65

# Max clarifying-question turns before forcing a "needs_human_review" outcome
MAX_CLARIFICATION_TURNS=2

# How many past (corrected/seed) examples to pull into the prompt as dynamic few-shot context
FEWSHOT_K=5

# Where local state lives (SQLite ticket/session store + Chroma vector store)
DATA_DIR=./app/data

# Optional: base64-encoded Firebase service account JSON key. When set,
# tickets/turns/corrections are stored in Firestore instead of the local
# SQLite file - needed on Render's free plan since its disk is ephemeral and
# would otherwise lose ticket history on every spin-down/redeploy. See
# persistent-storage-setup.md. Leave unset for local dev (keeps using SQLite).
# FIREBASE_CREDENTIALS_BASE64=eyJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCIsIC4uLn0=
# Only needed if your Firestore database was created under a custom Database
# ID instead of the default one:
# FIREBASE_DATABASE_ID=(default)
