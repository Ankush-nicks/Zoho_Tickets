# Environment / secrets
.env
*firebase-adminsdk*.json
*.serviceaccount.json

# Virtual environment
.venv/

# Local runtime state (SQLite ticket store + Chroma vector store)
app/data/

# Real ticket/instructor data exports (e.g. CSV imports for scripts/import_zoho_csv.py) -
# contains PII, never belongs in the repo
*.csv

# Accumulated results from scripts/compare_classifiers.py - contains real
# ticket text, personal research artifact not a project asset
scripts/.compare_results.jsonl

# Same reasoning for scripts/eval_classifier.py's per-run log and its
# rolling accuracy baseline - environment-specific, not a project asset
scripts/.eval_results.jsonl
scripts/.eval_baseline.json

# Python
__pycache__/
*.pyc

# Editor/tooling
.claude/
.agents/
skills-lock.json

# Local git worktrees used for isolated feature work
.worktrees/

# Per-POC extension config files contain a real, live auth token once filled
# in by the operator - only the *.example.js template is tracked
extensions/*/config.js
